{
  "name": "ai-factory",
  "private": true,
  "packageManager": "yarn@4.9.2",
  "workspaces": [
    "layers/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "yarn workspace @factory/prototype dev",
    "build": "yarn workspace @factory/prototype build",
    "lint": "eslint . && prettier --check \"**/*.{ts,vue,mjs,css}\"",
    "format": "prettier --write \"**/*.{ts,vue,mjs,css}\"",
    "typecheck": "yarn workspaces foreach -A --exclude ai-factory run typecheck",
    "test": "yarn workspaces foreach -A --exclude ai-factory run test",
    "check": "yarn lint && yarn typecheck && yarn test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.28.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
